{
  "name": "@flashsale/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@flashsale/config": "workspace:*",
    "@flashsale/database": "workspace:*",
    "@flashsale/logger": "workspace:*",
    "@flashsale/redis": "workspace:*",
    "@flashsale/shared": "workspace:*",
    "bullmq": "^5.28.0",
    "nodemailer": "^10.0.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@flashsale/eslint-config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.15.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
