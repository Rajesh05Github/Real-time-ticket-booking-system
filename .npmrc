# Workspace packages are linked from the workspace, never fetched from the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Fail fast if a package imports a dependency it did not declare.
# This is the guardrail that keeps the monorepo from rotting into implicit coupling.
strict-peer-dependencies=false
auto-install-peers=true

# Reproducible installs in CI/Docker.
resolution-mode=highest
