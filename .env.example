# Copy to .env and fill in. Real values NEVER get committed (.gitignore
# blocks .env already) -- see section 46 "secret management".
#
# One .env at the repo root is used by ALL processes in local dev (api,
# worker, web all read process.env directly -- no per-app .env duplication
# locally). Docker Compose (Phase 2) injects these as container env vars
# instead of mounting this file, so the same names work in both modes.

NODE_ENV=development

# --- PostgreSQL (docker-compose.yml service `postgres`) ---
# Phase 20: docker-compose.yml reads this directly (no fallback default
# committed there anymore) -- generate a real value for anything beyond
# local dev; Phase 21's AWS deployment pulls the production equivalent
# from a secrets manager instead of a .env file at all.
POSTGRES_PASSWORD=flashsale
# Host port is 5450, not the standard 5432 -- see docker-compose.yml for why.
DATABASE_URL=postgresql://flashsale:flashsale@localhost:5450/flashsale

# --- Redis (docker-compose.yml service `redis`) ---
# Host port is 6381, not the standard 6379 -- see docker-compose.yml for why.
REDIS_URL=redis://localhost:6381

# --- Logging ---
LOG_LEVEL=debug

# --- API (apps/api) ---
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-a-real-32-plus-character-secret-value
SHUTDOWN_TIMEOUT_MS=10000
# Shared secret the mock payment provider's webhook call must present --
# see docs/payment-flow.md.
PAYMENT_WEBHOOK_SECRET=replace-with-a-real-16-plus-character-secret-value

# --- Worker (apps/worker) ---
WORKER_CONCURRENCY=5
# Phase 20's health-check port -- deliberately a DIFFERENT variable name
# from api's PORT above (not just a different value), since both
# processes read this same shared .env file in host-run dev; docker-
# compose.yml gives each service its own isolated PORT, but nothing
# isolates two host-run processes reading one file. See
# apps/worker/src/env.ts's own comment.
WORKER_PORT=4100

# Email delivery for OTP verification codes (apps/worker/src/env.ts):
#   console -- log only (local dev default)
#   smtp    -- any SMTP relay; for local testing run Mailpit
#              (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) and
#              use SMTP_HOST=localhost SMTP_PORT=1025, no user/password
#   acs     -- Azure Communication Services Email (what infra/azure wires up)
EMAIL_PROVIDER=console
# EMAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=
# ACS_EMAIL_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=...

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
