// FLASHSALE database schema.
//
// PostgreSQL is the source of truth for everything in this file (section 28
// / docs/database.md's mental model: "PostgreSQL: what is actually true").
// Redis, Redis Streams, and BullMQ never become the permanent record of
// ticket ownership, seat state, or money -- they cache it, announce it, or
// schedule work around it, but this schema is what's actually correct.
//
// Naming convention: Prisma models/fields stay camelCase (idiomatic
// TypeScript); the underlying Postgres tables/columns are snake_case via
// @@map/@map, which is what a hand-written SQL migration would look like
// and what any raw-SQL tooling (psql, a BI tool, a future non-Prisma
// service) expects to see.

generator client {
  provider = "prisma-client-js"
  // "native" covers local development (Windows/macOS/Linux host). The
  // musl target is required once apps/api and apps/worker depend on this
  // package and get built by infra/docker/{api,worker}.Dockerfile -- those
  // images are node:22-ALPINE, which links libc via musl, not glibc, and
  // Prisma's query engine is a native binary compiled per libc/OpenSSL
  // combination. Without this, `prisma generate` on a host machine
  // produces an engine binary that silently fails to load inside the
  // Alpine container at runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  CANCELLED

  @@map("event_status")
}

/// Per-event seat inventory state. AVAILABLE -> RESERVED happens at claim
/// time (docs/reservation-flow.md); RESERVED -> SOLD only after payment
/// succeeds (never before -- section 24). A seat returns to AVAILABLE when
/// its reservation expires or is cancelled.
enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD

  @@map("seat_status")
}

enum ReservationStatus {
  RESERVED
  PENDING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED

  @@map("reservation_status")
}

/// Deliberately independent of ReservationStatus. ACTIVE means "this seat
/// is currently held by this reservation, regardless of where the parent
/// reservation is in its payment lifecycle" -- RELEASED means the seat is
/// free again. The seat-locking invariant (one seat, one active holder) is
/// a single partial unique index on (seatId) WHERE status = 'ACTIVE',
/// added via raw SQL in the initial migration since Prisma's schema
/// language has no partial-index syntax. See migration.sql and
/// docs/database.md for why this is the actual correctness boundary, not
/// the Redis lock.
enum ReservationItemStatus {
  ACTIVE
  RELEASED

  @@map("reservation_item_status")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED

  @@map("order_status")
}

/// REFUND_PENDING is a durable refund INTENT: written in the same
/// transaction as the business decision that requires money to go back
/// (a cancelled paid order, a late success on an already-cancelled
/// checkout, a genuine double payment). apps/worker's refund processor
/// picks these up and calls the provider -- a crash between "decide to
/// refund" and "provider accepted the refund" can never lose the refund,
/// because the intent is committed before the external call is made.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED

  @@map("payment_status")
}

enum TicketStatus {
  ISSUED
  CANCELLED

  @@map("ticket_status")
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED

  @@map("outbox_event_status")
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_key_status")
}

enum NotificationChannel {
  EMAIL

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

// ── Identity & auth ──────────────────────────────────────────────────────

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     Session[]
  reservations Reservation[]
  orders       Order[]
  tickets      Ticket[]
  notifications Notification[]
  auditLogs    AuditLog[]

  @@map("users")
}

/// A lightweight AUDIT/INDEX row, not the session store. The actual session
/// (fast-path lookup on every authenticated request) lives in Redis as
/// session:{sessionId} with a TTL (docs/redis.md, Phase 4). This Postgres
/// row exists so "log out all devices" and admin session visibility don't
/// require SCANning Redis's keyspace (an anti-pattern in production Redis)
/// -- it's written once at login and once at logout/revocation, never on
/// every request, keeping its write volume orders of magnitude lower than
/// Redis's.
///
/// `id` has NO default: the auth service generates the session id once and
/// uses that same value as both the Redis key suffix and this row's PK, so
/// there is deliberately no world where the two disagree on identity.
model Session {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ── Venue / event / seat inventory ───────────────────────────────────────

/// Reusable physical venue. A venue hosts many events over time.
model Venue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  address   String?
  city      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sections Section[]
  events   Event[]

  @@map("venues")
}

/// Reusable physical layout within a venue (e.g. "Section A"). Sections are
/// venue-scoped, NOT event-scoped -- the same physical section exists
/// across every event held at that venue.
model Section {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)
  seats Seat[]

  @@unique([venueId, name])
  @@map("sections")
}

model Event {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId     String      @map("venue_id") @db.Uuid
  name        String
  description String?
  status      EventStatus @default(DRAFT)
  startTime   DateTime    @map("start_time") @db.Timestamptz(3)
  endTime     DateTime?   @map("end_time") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  seats        Seat[]
  reservations Reservation[]
  tickets      Ticket[]

  @@index([status])
  @@index([startTime])
  @@index([venueId])
  // Serves the single most common public query: "published events, soonest
  // first" -- a composite index beats two separate single-column indexes
  // for this specific access pattern (section 29).
  @@index([status, startTime])
  @@map("events")
}

/// Seat inventory is EVENT-specific, not venue-specific: the same physical
/// seat in "Section A" is a different Seat row (different price, different
/// availability) for every event held in that section. Seats are created
/// as part of setting up an event's ticket inventory (section 3), not
/// reused across events.
model Seat {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  sectionId   String     @map("section_id") @db.Uuid
  seatCode    String     @map("seat_code")
  // Int, not BigInt: a single seat's price fits comfortably. Aggregated
  // order/payment totals (below) use BigInt for headroom instead.
  priceMinor  Int        @map("price_minor")
  currency    String     @default("INR")
  status      SeatStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section          Section            @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  reservationItems ReservationItem[]
  tickets          Ticket[]

  @@unique([eventId, sectionId, seatCode])
  // The core "find available seats for this event" query (section 29).
  @@index([eventId, status])
  @@map("seats")
}

// ── Reservation ───────────────────────────────────────────────────────────

model Reservation {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  // Denormalized: derivable via items -> seat -> event, but every list
  // query in docs/reservation-flow.md ("this user's reservations for this
  // event") wants it directly indexable without a join.
  eventId   String             @map("event_id") @db.Uuid
  status    ReservationStatus  @default(RESERVED)
  // Mirrors the Redis reservation:{id} hash's TTL -- Redis is the fast
  // path the BullMQ delayed job races against, but THIS column is what the
  // periodic sweeper job (docs/reservation-flow.md, Phase 9) checks. A
  // reservation that outlives its Redis key is still correctly expired by
  // the sweeper reading this column, which is the whole point of not
  // trusting Redis alone for the hold's durability.
  expiresAt DateTime           @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items ReservationItem[]
  order Order?

  @@index([userId])
  @@index([eventId])
  // The expiry sweeper's exact query: WHERE status = 'RESERVED' AND
  // expires_at < now(). See Phase 9.
  @@index([status, expiresAt])
  @@map("reservations")
}

/// One row per seat held by a reservation. THE correctness-critical table:
/// see the partial unique index added in migration.sql after this schema
/// is first migrated -- UNIQUE(seat_id) WHERE status = 'ACTIVE' is what
/// makes "one seat = one active reservation" a database-enforced fact
/// rather than an application-level promise (section 59).
model ReservationItem {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String                 @map("reservation_id") @db.Uuid
  seatId        String                 @map("seat_id") @db.Uuid
  status        ReservationItemStatus  @default(ACTIVE)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seat        Seat        @relation(fields: [seatId], references: [id], onDelete: Restrict)
  // Array, not a singular optional Ticket -- deliberately. Prisma requires
  // a plain @unique on the FK to model a true 1:1, but the real
  // constraint here is the partial index above (scoped to status =
  // 'ISSUED'), which allows a CANCELLED ticket row to coexist with a
  // later reissued one for the same seat. Modeling this as Ticket[] is
  // the semantically honest cardinality, not a workaround: callers filter
  // by status when they want "the current ticket", e.g.
  // `.find(t => t.status === 'ISSUED')`.
  tickets     Ticket[]

  @@index([reservationId])
  // A plain (non-partial) index for lookups regardless of status; the
  // partial UNIQUE index added in raw SQL is the correctness invariant,
  // this one is just for query performance on RELEASED rows too.
  @@index([seatId])
  @@map("reservation_items")
}

// ── Payment & tickets ─────────────────────────────────────────────────────

model Order {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  reservationId String      @unique @map("reservation_id") @db.Uuid
  status        OrderStatus @default(PENDING)
  // BigInt: this is a SUM across up to MAX_SEATS_PER_RESERVATION seats:
  // needs more headroom than a single seat's Int price.
  amountMinor   BigInt      @map("amount_minor")
  currency      String      @default("INR")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  payments    Payment[]
  tickets     Ticket[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

/// (N)-1 with Order, not 1-to-1: a failed payment attempt legitimately gets
/// retried, producing a second Payment row against the same Order. Exactly
/// one of them should ever reach SUCCEEDED -- enforcing THAT is Phase 13's
/// job at the application layer (idempotency + provider abstraction), not
/// this schema's.
///
/// `providerRef` is `@unique` (added Phase 13, alongside the webhook
/// handler that actually looks payments up by it): a webhook delivery
/// identifies WHICH charge attempt it's about purely by this value, so
/// two different Payment rows ever sharing one would mean one payment's
/// webhook could resolve a completely different payment. Safe to be
/// unique despite starting `null` (set only after `charge()` returns,
/// Phase 13) because Postgres's unique constraints treat every NULL as
/// distinct from every other NULL -- many PENDING payments can sit with
/// providerRef = NULL simultaneously without conflict; only a real,
/// non-null collision would ever violate this.
model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  provider    String
  providerRef String?       @unique @map("provider_ref")
  status      PaymentStatus @default(PENDING)
  amountMinor BigInt        @map("amount_minor")
  currency    String        @default("INR")
  // Set by apps/worker's refund processor once the provider accepts the
  // refund (REFUND_PENDING -> REFUNDED).
  refundProviderRef String?   @unique @map("refund_provider_ref")
  refundedAt        DateTime? @map("refunded_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  // The refund processor's query: WHERE status = 'REFUND_PENDING'.
  @@index([status])
  @@map("payments")
}

model Ticket {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Public-facing code (e.g. a short nanoid), distinct from the internal
  // UUID -- what a QR code or customer support conversation references.
  ticketNumber      String       @unique @map("ticket_number")
  userId            String       @map("user_id") @db.Uuid
  eventId           String       @map("event_id") @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  // NOT @unique here: the real constraint is a hand-written PARTIAL unique
  // index (tickets_active_reservation_item_unique, migration.sql) scoped
  // to status = 'ISSUED', which Prisma's schema language cannot express.
  // A plain @unique would incorrectly block ever re-issuing a ticket for
  // a reservation_item whose earlier ticket was cancelled. See
  // docs/database.md.
  reservationItemId String       @map("reservation_item_id") @db.Uuid
  // Denormalized alongside reservationItemId: lets a ticket display/query
  // skip a join through ReservationItem purely to show which seat it is --
  // via the DIRECT `seat` relation below, a real FK+relation like every
  // other reference on this model, not a bare unlinked column. (A bare
  // `seatId` scalar with no relation was a real gap here until Phase 14:
  // it made `include: { seat: true }` impossible, defeating the whole
  // point of denormalizing this field in the first place -- found live
  // when GET /tickets/:id actually tried to use it.)
  seatId            String       @map("seat_id") @db.Uuid
  status            TicketStatus @default(ISSUED)
  issuedAt          DateTime     @default(now()) @map("issued_at") @db.Timestamptz(3)
  cancelledAt       DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reservationItem ReservationItem @relation(fields: [reservationItemId], references: [id], onDelete: Restrict)
  seat            Seat            @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([eventId])
  @@index([reservationItemId])
  @@index([seatId])
  @@map("tickets")
}

// ── Notifications ─────────────────────────────────────────────────────────

/// The durable notification record. Phase 7's Redis List
/// (notifications:user:{userId}, capped at 50 via LPUSH/LTRIM) is a
/// fast "recent activity feed" VIEW over this data, not a replacement for
/// it -- if Redis loses that list, nothing is actually lost, because this
/// table is what's real.
model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel @default(EMAIL)
  type      String
  payload   Json
  status    NotificationStatus  @default(PENDING)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ── Transactional outbox (Phase 10) ───────────────────────────────────────

/// Written in the SAME transaction as the business row it describes
/// (reservation, payment, ticket, ...). A separate Outbox Publisher worker
/// polls WHERE status = 'PENDING' and XADDs to Redis Streams, then flips
/// status to PUBLISHED -- this is what makes "commit the business change"
/// and "announce the event happened" atomic, instead of a dual-write that
/// can crash between the two halves (section 8).
model OutboxEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  eventType     String            @map("event_type")
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz(3)

  // The publisher worker's exact query: WHERE status = 'PENDING' ORDER BY
  // created_at. A composite index matches that access pattern directly.
  @@index([status, createdAt])
  @@map("outbox_events")
}

// ── Idempotency (section 22) ──────────────────────────────────────────────

/// Scoped by (route, key), not key alone: a client-supplied Idempotency-Key
/// header is only meaningful within the endpoint it was sent to. requestHash
/// lets the API detect "same key, different request body" misuse and
/// reject it (422) instead of silently replaying an unrelated cached
/// response. status=IN_PROGRESS is written by the FIRST concurrent request
/// to successfully INSERT this row -- the insert's uniqueness constraint
/// IS the lock a second concurrent duplicate request bounces off of,
/// which is what actually closes the "two simultaneous double-clicks both
/// see no existing key" race that a naive "check then insert" would miss.
model IdempotencyKey {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String
  route          String
  requestHash    String                @map("request_hash")
  status         IdempotencyKeyStatus  @default(IN_PROGRESS)
  responseStatus Int?                  @map("response_status")
  responseBody   Json?                 @map("response_body")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?             @map("completed_at") @db.Timestamptz(3)

  @@unique([route, key])
  // apps/worker's idempotency-key cleanup job: delete rows by status
  // older than a retention window (see IDEMPOTENCY_KEY_RETENTION_MS).
  @@index([status, createdAt])
  @@map("idempotency_keys")
}

// ── Stream consumer idempotency (Phase 11) ────────────────────────────────

/// Not used until Phase 11, created now so the ER model is complete from
/// the start. Redis Stream consumer groups redeliver on crash/restart by
/// design (XREADGROUP + XCLAIM); a consumer that mutates state (sends an
/// email, increments a counter) must check this table for
/// (consumerGroup, eventId) before acting, and record it in the SAME
/// transaction as the mutation -- a Redis SET for this would be lost on a
/// Redis restart, silently reintroducing the duplicate-processing bug this
/// table exists to prevent.
model ProcessedEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumerGroup String   @map("consumer_group")
  eventId       String   @map("event_id")
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([consumerGroup, eventId])
  @@map("processed_events")
}

// ── Audit ──────────────────────────────────────────────────────────────────

/// Generic admin/system action trail (event published, reservation
/// force-cancelled, price changed, ...). actorId is nullable because some
/// actions are system-initiated (the expiry sweeper cancelling a
/// reservation), not performed by a human.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
